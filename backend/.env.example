# ──────────────────────────────────────────────────────────────
# KeepEat Backend — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.
# NE JAMAIS committer .env (il est dans .gitignore).
# ──────────────────────────────────────────────────────────────

# ── Base de données ────────────────────────────────────────────
# URL de connexion MongoDB Atlas (obligatoire)
MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=keepeat_db

# ── Sécurité ───────────────────────────────────────────────────
# Clé secrète JWT — générer avec : python -c "import secrets; print(secrets.token_hex(32))"
# OBLIGATOIRE — le serveur refusera de démarrer sans cette valeur.
JWT_SECRET_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Pour une app mobile-only, * est acceptable.
# Restreindre à des origines spécifiques si un frontend web est ajouté.
CORS_ORIGINS=*

# ── Google Play Billing ────────────────────────────────────────
# Package Android de l'app (défaut : com.fesperiquette.keepeat)
GOOGLE_ANDROID_PACKAGE=com.fesperiquette.keepeat

# Contenu JSON du compte de service Google Cloud (rôle : "Android Publisher")
# Obtenir dans Google Cloud Console > IAM > Comptes de service > Clé JSON
# Coller l'intégralité du JSON en une seule ligne (ou utiliser une variable multi-ligne Render).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Token d'authentification pour le webhook RTDN Pub/Sub (optionnel mais recommandé)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
GOOGLE_RTDN_TOKEN=

# ── Emails (Brevo SMTP) ────────────────────────────────────────
# Clé API Brevo (anciennement SendinBlue)
BREVO_API_KEY=
# Adresse expéditrice (ex : noreply@keepeat.app)
MAIL_FROM=
# Nom affiché de l'expéditeur
MAIL_FROM_NAME=KeepEat

# ── OpenAI (OCR + Recettes IA) ─────────────────────────────────
# Sans cette clé, les routes /api/ocr/receipt et /api/recipes/ai retournent 503.
KEEPEAT_OPENAI_TOKEN=
# Enrichissement GPT silencieux des suggestions /api/recipes/suggestions (premium uniquement).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Administration ─────────────────────────────────────────────
# Emails des administrateurs (séparés par des virgules)
ADMIN_EMAILS=

# ── Déploiement ────────────────────────────────────────────────
BACKEND_URL=https://keepeat-backend.onrender.com
# Identifiant du commit (injecté automatiquement par Render)
# RENDER_GIT_COMMIT=

# ── Compte dev seed (optionnel) ────────────────────────────────
# Crée automatiquement un compte premium vérifié au démarrage.
# Le mot de passe doit respecter : 8+ chars, majuscule, minuscule, chiffre, caractère spécial.
SEED_EMAIL=
SEED_PASSWORD=
