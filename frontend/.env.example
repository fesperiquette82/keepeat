# ──────────────────────────────────────────────────────────────
# KeepEat Frontend — Variables d'environnement Expo
# Copier ce fichier en .env (dev) ou .env.production (prod).
# NE JAMAIS committer .env (il est dans .gitignore).
# Les variables EXPO_PUBLIC_* sont visibles côté client (bundle JS).
# ──────────────────────────────────────────────────────────────

# ── API Backend ────────────────────────────────────────────────
# URL de base du backend FastAPI
EXPO_PUBLIC_BACKEND_URL=https://keepeat-backend.onrender.com

# ── Environnement ──────────────────────────────────────────────
# Valeurs possibles : development | staging | production
EXPO_PUBLIC_APP_ENV=production

# Variante de build Expo (development | preview | production)
EXPO_PUBLIC_APP_VARIANT=production

# ── Administration ─────────────────────────────────────────────
# Emails des administrateurs séparés par des virgules (affiche un menu admin dans l'app)
EXPO_PUBLIC_ADMIN_EMAILS=

# ── Outils de debug (désactiver en production) ─────────────────
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=false
EXPO_PUBLIC_ENABLE_VERBOSE_LOGS=false
EXPO_PUBLIC_ENABLE_DIAGNOSTIC_SCREEN=false
EXPO_PUBLIC_ENABLE_NETWORK_TRACING=false

# ── Recettes ───────────────────────────────────────────────────
EXPO_PUBLIC_DEFAULT_RECIPE_SERVINGS=4

# ── Sécurité ───────────────────────────────────────────────────
# URLs de l'API autorisées en production (séparées par des virgules)
# Empêche l'app d'appeler un backend non officiel si recompilée
EXPO_PUBLIC_ALLOWED_PROD_API_URLS=https://keepeat-backend.onrender.com
