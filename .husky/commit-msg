#!/bin/bash

# Commit message hook — Format validation + User-visible bug coverage check
# This runs before a commit is finalized

COMMIT_MSG_FILE=$1

# Read the commit message
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip validation for merge commits and rebase operations
if [[ $COMMIT_MSG == Merge* ]] || [[ $COMMIT_MSG == Rebase* ]]; then
  exit 0
fi

# Step 1: Validate commit message format
# Pattern: <type>(<scope>): <description>
# - type: feat|fix|refactor|test|docs|chore|style|perf
# - scope: optional, but if present must be in parentheses
# - description: required, non-empty
PATTERN="^(feat|fix|refactor|test|docs|chore|style|perf)(\([a-z0-9\-]+\))?!?: .{1,}$"

if ! [[ $COMMIT_MSG =~ $PATTERN ]]; then
  echo "❌ Commit message format violation"
  echo ""
  echo "Expected format: <type>(<scope>): <description>"
  echo "Example: feat(recipes): add filtering by category"
  echo ""
  echo "Allowed types:"
  echo "  • feat     — new feature"
  echo "  • fix      — bug fix"
  echo "  • refactor — code refactoring"
  echo "  • test     — test additions/updates"
  echo "  • docs     — documentation"
  echo "  • chore    — maintenance (deps, build, etc.)"
  echo "  • style    — code style (formatting, etc.)"
  echo "  • perf     — performance improvement"
  echo ""
  echo "Your message: $COMMIT_MSG"
  echo ""
  exit 1
fi

# Step 2: Validate test coverage for user-visible bugs (fix commits)
if command -v node &> /dev/null; then
  if [[ $COMMIT_MSG == fix* ]] || [[ $COMMIT_MSG == *"fix:"* ]]; then
    echo "[commit-msg] Validating test coverage for bug fix..."
    node scripts/validate-user-visible-bug-coverage.mjs "$COMMIT_MSG_FILE" || true
  fi
fi

exit 0
